# Patterns to ignore when building Helm packages.
# This supports shell glob matching, relative path matching, and negation
# (prefixed with !).

# Common VCS files
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/

# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~

# Common OS files
.DS_Store

# Helm subchart artifacts (committed for reproducibility; ignored on package)
# (none yet — populated by `helm dependency update` in Task #5)

# IDE files
.vscode/
.idea/

# Post-renderer plugin lives alongside the chart but ships separately
# via `helm plugin install`. Exclude it from `helm package` output so
# the published OCI chart has no plugin contamination.
post-renderer/
